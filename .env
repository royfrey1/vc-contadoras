# Modo DEMO del sitio (ver src/config.js):
#   true  → <meta name="robots" content="noindex, nofollow"> y JSON-LD del estudio desactivado.
#   false → producción: el sitio se puede indexar y se publica el JSON-LD (AccountingService).
# Al pasar a producción, cambiarla a false (acá o en Settings → Environment Variables de Vercel)
# y actualizar public/robots.txt.
VITE_DEMO=true
